{
  "_note": "评分维度 scoring_dimensions 应从 CourseSubgraphService.inferProfile() 动态获取。",
  "_note2": "不同课程类型的评分维度：软件=功能/技术/整合/质量/文档、文学=理解/证据/审美/方法/表达、体育=动作/技能/战术/体能/态度。",
  "_note3": "此文件仅作为结构模板，实际评分维度由课程画像决定。",
  "version": "1.1.0",
  "course_name": "",
  "total_score": 100,
  "components": [
    {
      "name": "平时成绩",
      "weight": 30,
      "sub_items": [
        {"name": "课堂参与", "weight": 10, "description": "课堂互动、回答问题"},
        {"name": "课后作业", "weight": 10, "description": "每章课后练习题"},
        {"name": "考勤", "weight": 10, "description": "出勤记录"}
      ]
    },
    {
      "name": "实践成绩",
      "weight": 30,
      "sub_items": []
    },
    {
      "name": "期末考核",
      "weight": 40,
      "sub_items": [
        {"name": "项目完成度", "weight": 15, "description": "任务完成质量"},
        {"name": "答辩表现", "weight": 10, "description": "演示效果、问答表现"},
        {"name": "报告质量", "weight": 10, "description": "文档完整性、专业深度"},
        {"name": "团队协作", "weight": 5, "description": "分工合理性、协作效果"}
      ]
    }
  ],
  "scoring_dimensions": [
    {"name": "知识理解", "max_score": 25, "description": "概念掌握、原理理解"},
    {"name": "实践应用", "max_score": 20, "description": "技能运用、操作规范"},
    {"name": "问题分析", "max_score": 25, "description": "问题识别、方案设计"},
    {"name": "表达呈现", "max_score": 15, "description": "报告质量、演示效果"},
    {"name": "持续改进", "max_score": 15, "description": "反思总结、改进方向"}
  ],
  "grading_scale": [
    {"grade": "优秀", "min": 90, "max": 100},
    {"grade": "良好", "min": 80, "max": 89},
    {"grade": "中等", "min": 70, "max": 79},
    {"grade": "及格", "min": 60, "max": 69},
    {"grade": "不及格", "min": 0, "max": 59}
  ],
  "report_templates": [
    {"keyword": "实践报告", "file": "实践报告模板.md", "label": "实践报告"},
    {"keyword": "项目报告", "file": "项目报告模板.md", "label": "项目报告"},
    {"keyword": "答辩", "file": "答辩报告模板.md", "label": "答辩报告"},
    {"keyword": "默认", "file": "通用报告模板.md", "label": "通用报告"}
  ],
  "repo_norms": {
    "repo_prefix": [],
    "repo_format": "{仓库标识}",
    "branch_format": "feat-{姓名拼音首字母小写}",
    "branch_pattern": "^feat-[a-z]{2,5}$",
    "commit_format": "<类型>: <简短描述>",
    "commit_types": ["feat", "fix", "docs", "style", "refactor", "test", "chore"],
    "report_dir": "docs/reports/",
    "report_naming": "任务X_姓名.md",
    "defense_dir": "docs/defense/",
    "works_dir": "works/"
  }
}
