#!/usr/bin/env bash
# ===========================================================================
# .githooks/pre-commit — 提交前检查
# ===========================================================================
# 1. OHOS 补丁残留检查（拦截 ohos_patch 误提交）
# 2. 禁止提交大文件（>10MB）
# 3. 检查 staged 的 .dart 文件是否有语法错误（快速 dart analyze）
# ===========================================================================

set -eu

repo_root=$(git rev-parse --show-toplevel)

# ── 1. OHOS 补丁检查 ──────────────────────────────────────────────────
guard="$repo_root/scripts/check_no_ohos_patch.sh"
if [ -f "$guard" ]; then
  bash "$guard" || {
    echo "❌ pre-commit: OHOS 补丁残留检查失败"
    exit 1
  }
fi
echo "✓ pre-commit: OHOS 检查通过"

# ── 2. 大文件检查 ──────────────────────────────────────────────────────
big_files=$(git diff --cached --name-only --diff-filter=ACM | \
  while IFS= read -r f; do
    if [ -f "$f" ]; then
      size=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null || echo 0)
      if [ "$size" -gt 10485760 ]; then
        echo "$f (${size} bytes)"
      fi
    fi
  done)

if [ -n "$big_files" ]; then
  echo "⚠  以下 staged 文件超过 10MB，确认后提交:"
  echo "$big_files"
  echo "跳过检查：git commit --no-verify"
fi

# ── 3. 快速 dart 语法检查（只检查 staged 的 .dart 文件）─────────────
staged_dart=$(git diff --cached --name-only --diff-filter=ACM | \
  grep '\.dart$' | grep -v '\.g\.dart$' | grep -v '\.freezed\.dart$' || true)

if [ -n "$staged_dart" ]; then
  # 逐文件 quick syntax check（不走完整 flutter analyze）
  errors=0
  for f in $staged_dart; do
    if [ -f "$f" ]; then
      # dart analyze --fatal-infos 只在文件上做快速检查
      output=$(dart analyze --fatal-infos "$f" 2>&1 || true)
      if echo "$output" | grep -q "error\|Error"; then
        echo "❌ $f 有语法错误"
        echo "$output" | grep "error\|Error"
        errors=$((errors + 1))
      fi
    fi
  done
  if [ "$errors" -gt 0 ]; then
    echo "❌ pre-commit: $errors 个文件有语法错误，请修复后提交"
    echo "   跳过检查：git commit --no-verify"
    exit 1
  fi
  echo "✓ pre-commit: ${errors} 语法错误 — 通过"
fi

echo "✓ pre-commit: 全部检查通过"
exit 0
